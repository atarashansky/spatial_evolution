{
 "track": "Round 9 reanalysis, task C: placing real esophagus on the nu-sweep's largest-lineage-fraction axis",
 "definitions": {
  "model_f1": "f1_stat = time-average over the run's stationary window (t >= 0.1 t_max) of (cells in the largest lineage)/(live cells in the 192x64 domain), from nu_sweep_analyse.py; nu = probability that a birth founds a NEW unlabelled lineage",
  "tissue_f1_primary": "f1_tissue = (area of the largest labelled clone in a mouse)/(that mouse's total oesophageal-epithelium area, oe_area_um2), mean over mice with mouse-level bootstrap CI (B=4000)",
  "tissue_f1_upper_bound": "f1_of_labelled = largest clone / summed labelled clone area \u2014 corrects for the low label density (labelled fraction 1-6%) and therefore OVERSTATES the fraction any lineage occupies of the whole tissue; carried only as a ceiling",
  "detection_floor_um2": 50.27,
  "clone_size_units": "um2 (per-clone YFP area, Colom 2020 Suppl. Table 6); tissue = mouse oesophageal epithelium (the deposit carries no skin table)"
 },
